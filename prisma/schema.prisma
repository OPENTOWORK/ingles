// Speaking module + CMS — Postgres (Supabase compatible)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CefrLevel {
  A2
  B1
  B2
  C1
  C2
}

enum CambridgeExam {
  KEY
  PET
  FIRST
  ADVANCED
  PROFICIENCY
}

enum SpeakingMode {
  PRACTICE
  CORRECTION
  EXAM
}

enum SpeakingTaskType {
  INTERVIEW
  LONG_TURN
  COLLABORATIVE
  DISCUSSION
  OTHER
}

enum SessionState {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum TurnRole {
  USER
  ASSISTANT
}

enum TranscriptSource {
  STT
  TYPED
  MOCK
}

model SpeakingTask {
  id                String           @id @default(cuid())
  title             String
  cefr              CefrLevel
  examType          CambridgeExam    @map("exam_type")
  part              Int
  prompt            String           @db.Text
  followUpQuestions Json             @default("[]") @map("follow_up_questions")
  targetVocabulary  Json             @default("[]") @map("target_vocabulary")
  timeLimitSec      Int?             @map("time_limit_sec")
  taskType          SpeakingTaskType @map("task_type")
  metadata          Json?
  published         Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([cefr, examType, part])
  @@index([published])
  @@map("speaking_tasks")
}

model SpeakingExam {
  id                       String    @id @default(cuid())
  cefr                     CefrLevel
  title                    String
  theme                    String
  content                  Json
  estimatedDurationMinutes Int       @default(14) @map("estimated_duration_minutes")
  examSlot                 Int?      @map("exam_slot")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  sessions SpeakingSession[]

  @@index([cefr, isActive])
  @@index([examSlot])
  @@map("speaking_exams")
}

model SpeakingSession {
  id                   String        @id @default(cuid())
  userId               String?       @map("user_id")
  mode                 SpeakingMode
  cefr                 CefrLevel
  exam                 CambridgeExam
  state                SessionState  @default(ACTIVE)
  examBlueprintVersion String        @default("1") @map("exam_blueprint_version")
  examState            Json?         @map("exam_state")
  speakingExamId       String?       @map("speaking_exam_id")
  speakingExam         SpeakingExam? @relation(fields: [speakingExamId], references: [id], onDelete: SetNull)
  startedAt            DateTime      @default(now()) @map("started_at")
  endedAt              DateTime?     @map("ended_at")

  turns       SpeakingTurn[]
  evaluations SpeakingEvaluation[]

  @@index([userId, startedAt])
  @@index([cefr, mode])
  @@index([speakingExamId])
  @@map("speaking_sessions")
}

model SpeakingTurn {
  id               String           @id @default(cuid())
  sessionId        String           @map("session_id")
  session          SpeakingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role             TurnRole
  text             String           @db.Text
  transcriptSource TranscriptSource @default(MOCK) @map("transcript_source")
  audioUrl         String?          @map("audio_url")
  microFeedback    Json?            @map("micro_feedback")
  partNumber       Int?             @map("part_number")
  turnIndex        Int?             @map("turn_index")
  speakerRole      String?          @map("speaker_role")
  createdAt        DateTime         @default(now()) @map("created_at")

  evaluations SpeakingEvaluation[]

  @@index([sessionId, createdAt])
  @@index([sessionId, partNumber])
  @@map("speaking_turns")
}

model SpeakingEvaluation {
  id        String          @id @default(cuid())
  sessionId String          @map("session_id")
  session   SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnId    String?         @map("turn_id")
  turn      SpeakingTurn?   @relation(fields: [turnId], references: [id], onDelete: SetNull)
  payload   Json

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("speaking_evaluations")
}
