{
  "name": "english-practice",
  "version": "1.0.0",
  "description": "Plataforma completa de práctica de inglés con IA adaptativa, gamificación y modo offline",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:fresh": "node scripts/clean-next-cache.mjs && next dev",
    "prebuild": "node -e \"if(process.env.VERCEL==='1'&&process.env.NEXT_STATIC_EXPORT!=='true'){process.exit(0)}require('child_process').execSync('node scripts/write-static-export-layouts.mjs',{stdio:'inherit'})\"",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "build:static:full": "node scripts/build-static-full.mjs",
    "start": "next start",
    "lint": "next lint",
    "setup": "node setup.js",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "db:setup": "echo 'Configurar base de datos desde la aplicación'",
    "db:reset": "echo 'Reiniciar base de datos desde la aplicación'",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.cjs",
    "db:studio": "prisma studio",
    "analyze": "ANALYZE=true npm run build",
    "test": "node --loader ./scripts/alias-loader.mjs --test scripts/test-b2-scoring-v2.mjs src/lib/__tests__/gradeB2KeyWordTransformation.test.js src/lib/__tests__/parseB2KeyWordAnswerKey.test.js src/lib/__tests__/part4UiIntegration.test.js src/lib/__tests__/levelsStars.test.js src/lib/__tests__/saveLevelStars.test.js src/lib/__tests__/deletePartContentForExam.test.js src/lib/__tests__/writingFeedbackRegression.test.js src/features/speaking/services/sessions/__tests__/speaking-turn-context.test.js scripts/test-b2-part4-live-answer-keys.mjs scripts/test-b2-part1-validator.mjs scripts/test-b2-part2-validator.mjs scripts/test-b2-part3-validator.mjs scripts/test-b2-part4-validator.mjs scripts/test-b2-part5-validator.mjs scripts/test-b2-part6-validator.mjs scripts/test-b2-reading-quality-validators.mjs",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate && node setup.js",
    "supabase:auth-disable-email-confirm": "node scripts/supabase-patch-auth-mailer-autoconfirm.mjs",
    "support:email-setup": "node scripts/support-email-setup.mjs",
    "sync:email-vercel": "node scripts/sync-email-env-vercel.mjs",
    "supabase:service-role-setup": "node scripts/supabase-service-role-setup.mjs",
    "supabase:sync-service-role": "node scripts/sync-supabase-service-role.mjs",
    "supabase:duplicate-to-dralo": "node scripts/duplicate-supabase-to-dralo.mjs --dry-run",
    "supabase:duplicate-to-dralo:copy": "node scripts/duplicate-supabase-to-dralo.mjs --data-only",
    "supabase:materialize-auth-export": "node scripts/materialize-auth-export.mjs",
    "supabase:duplicate-auth-to-dralo": "node scripts/duplicate-auth-to-dralo.mjs",
    "supabase:duplicate-storage-to-dralo": "node scripts/duplicate-storage-to-dralo.mjs",
    "supabase:duplicate-all-to-dralo": "node scripts/materialize-auth-export.mjs && node scripts/duplicate-auth-to-dralo.mjs && node scripts/duplicate-supabase-to-dralo.mjs --data-only && node scripts/duplicate-storage-to-dralo.mjs",
    "supabase:materialize-dralo-schema": "node scripts/materialize-dralo-schema.mjs",
    "supabase:apply-dralo-schema": "node scripts/apply-dralo-b-schema.mjs",
    "regen:a2-exam": "node --loader ./scripts/alias-loader.mjs scripts/regen-a2-exam-parts.mjs",
    "regen:a2-part": "node --loader ./scripts/alias-loader.mjs scripts/regen-a2-part.mjs",
    "regen:b2-exam": "node --loader ./scripts/alias-loader.mjs scripts/regen-b2-exam.mjs",
    "clone:b2-exam": "node --loader ./scripts/alias-loader.mjs scripts/clone-b2-exam-random.mjs",
    "seed:b2-exam6": "node --loader ./scripts/alias-loader.mjs scripts/seed-b2-exam6-offline.mjs",
    "synth:b2-exam6-audio": "node --loader ./scripts/alias-loader.mjs scripts/synth-b2-exam6-audio.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.38.0",
    "autoprefixer": "^10.4.20",
    "edge-tts-universal": "^1.4.0",
    "lucide-react": "^1.14.0",
    "music-metadata": "^11.0.0",
    "next": "^14.0.0",
    "nodemailer": "^8.0.7",
    "openai": "^4.0.0",
    "postcss": "^8.4.49",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.0",
    "resend": "^4.0.0",
    "stripe": "^22.2.1",
    "tailwindcss": "^3.4.15",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "^18.0.0",
    "baseline-browser-mapping": "^2.10.29",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "mammoth": "^1.12.0",
    "pg": "^8.20.0",
    "prisma": "^6.16.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "english",
    "learning",
    "education",
    "nextjs",
    "react",
    "supabase",
    "offline-first",
    "adaptive-learning",
    "gamification"
  ],
  "author": "Tu Nombre <tu-email@ejemplo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/english-practice.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/english-practice/issues"
  },
  "homepage": "https://github.com/tu-usuario/english-practice#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
