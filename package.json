{
  "name": "english-practice",
  "version": "1.0.0",
  "description": "Plataforma completa de práctica de inglés con IA adaptativa, gamificación y modo offline",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/write-static-export-layouts.mjs",
    "build": "next build",
    "build:static": "cross-env NEXT_STATIC_EXPORT=true npm run build",
    "build:static:full": "node scripts/build-static-full.mjs",
    "start": "next start",
    "lint": "next lint",
    "setup": "node setup.js",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "db:setup": "echo 'Configurar base de datos desde la aplicación'",
    "db:reset": "echo 'Reiniciar base de datos desde la aplicación'",
    "analyze": "ANALYZE=true npm run build",
    "test": "echo 'Tests no implementados aún'",
    "type-check": "tsc --noEmit",
    "postinstall": "node setup.js",
    "supabase:auth-disable-email-confirm": "node scripts/supabase-patch-auth-mailer-autoconfirm.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "autoprefixer": "^10.4.20",
    "next": "^14.0.0",
    "openai": "^4.0.0",
    "postcss": "^8.4.49",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.0",
    "resend": "^4.0.0",
    "tailwindcss": "^3.4.15",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "^18.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "english",
    "learning",
    "education",
    "nextjs",
    "react",
    "supabase",
    "offline-first",
    "adaptive-learning",
    "gamification"
  ],
  "author": "Tu Nombre <tu-email@ejemplo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/english-practice.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/english-practice/issues"
  },
  "homepage": "https://github.com/tu-usuario/english-practice#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
