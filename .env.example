# Copia este archivo a .env.local y rellena los valores.
# Nunca subas .env.local a git (ya está en .gitignore).

# Supabase (cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tickets de soporte → bandeja de entrada
SUPPORT_TICKET_TO_EMAIL=draloenglish@gmail.com

# Resend (correo de aviso de tickets). Con dominio verificado en resend.com/domains:
# RESEND_FROM_EMAIL=soporte@tudominio.com
RESEND_API_KEY=

# Supabase (solo servidor): evita el límite de emails de registro de Auth.
# Dashboard → Settings → API → service_role (no la publiques en el cliente).
SUPABASE_SERVICE_ROLE_KEY=

# Solo para scripts contra la Management API (nunca en el cliente ni en el repo).
# Cuenta → Access Tokens: https://supabase.com/dashboard/account/tokens
# Uso: node scripts/supabase-patch-auth-mailer-autoconfirm.mjs
SUPABASE_ACCESS_TOKEN=

# Clave de API: https://platform.openai.com/api-keys
# Usada por Dralo AI, Speaking y el chatbot de ayuda de la web (esquina inferior derecha).
OPENAI_API_KEY=

# Opcional: modelo para /api/feedback/essay (mismo prompt, distinta calidad/coste)
OPENAI_MODEL=gpt-4o-mini

# Para builds estáticas (output=export): URL pública del backend que sí expone /api/*
# Ejemplo: https://tu-app-dinamica.vercel.app
NEXT_PUBLIC_AI_API_BASE_URL=
