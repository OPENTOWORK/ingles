# Copia este archivo a .env.local y rellena los valores.
# Nunca subas .env.local a git (ya está en .gitignore).

# Microsoft Clarity (mapas de calor, grabaciones anónimas, funnels).
# Solo se carga si el usuario acepta cookies analíticas.
# Panel: https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=x4qtfjtnkz
# Token de exportación (solo servidor): Clarity → Settings → Data Export → Generate API token
CLARITY_API_TOKEN=

# Supabase (cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tickets de soporte → bandeja de entrada
SUPPORT_TICKET_TO_EMAIL=draloenglish@gmail.com

# Resend (correo de aviso de tickets). Con dominio verificado en resend.com/domains:
# RESEND_FROM_EMAIL=soporte@tudominio.com
RESEND_API_KEY=

# Supabase (solo servidor): evita el límite de emails de registro de Auth.
# Dashboard → Settings → API → service_role (no la publiques en el cliente).
SUPABASE_SERVICE_ROLE_KEY=

# Solo para scripts contra la Management API (nunca en el cliente ni en el repo).
# Cuenta → Access Tokens: https://supabase.com/dashboard/account/tokens
# Uso: node scripts/supabase-patch-auth-mailer-autoconfirm.mjs
SUPABASE_ACCESS_TOKEN=

# Clave de API (misma cuenta OpenAI que tus GPT en ChatGPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Motor OpenAI en producción (Chat Completions + prompts en src/lib/ai/prompts/)
DRALO_OPENAI_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o

# API unificada: POST /api/dralo-ai  (assistantType: exam | realLife)
# Cliente: import { callDraloAi } from '@/lib/ai/draloAiClient'
# Pantalla de prueba: /dralo-ai/test

# --- GPT clonados como Assistants (OpenAI API) ---
# Real-Life: solo si DRALO_USE_OPENAI_ASSISTANTS=true
# DRALO_USE_OPENAI_ASSISTANTS=true
# OPENAI_ASSISTANT_ID_REAL_LIFE=asst_xxxxxxxx
#
# Examenes de cambridge (generación/regeneración de exámenes Levels):
# Copia el asst_… desde platform.openai.com/assistants (NO uses el g-… de chatgpt.com/g/…)
# GPT: https://chatgpt.com/g/g-6a146ba37be4819189ee9f9bd8ceda98-examenes-de-cambrigde
OPENAI_ASSISTANT_ID_CAMBRIDGE_EXAMS=asst_xxxxxxxx

# Modelos opcionales por motor
# OPENAI_MODEL_REAL_LIFE=gpt-4o
# OPENAI_MODEL_CAMBRIDGE=gpt-4o

# Fotos nuevas en Speaking Part 2 (Dralo AI). Por defecto gpt-image-1 (no uses response_format).
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_MODEL=dall-e-3

# Generación de exámenes Levels (admin): motor "Examenes de cambridge" + SUPABASE_SERVICE_ROLE_KEY
# Audios listening → bucket público Levels_Listening en Supabase Storage

# Solo si quieres usar Gemini cuando OpenAI falle (speaking coach)
# DRALO_ALLOW_GEMINI_FALLBACK=true

# Para builds estáticas (output=export): URL pública del backend que sí expone /api/*
# Ejemplo: https://tu-app-dinamica.vercel.app
NEXT_PUBLIC_AI_API_BASE_URL=
