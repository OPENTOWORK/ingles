# Configuración de Supabase (Opcional - funciona sin esto)
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME="English Practice"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Configuración de desarrollo
NODE_ENV=development

# URLs de audio (opcional)
NEXT_PUBLIC_AUDIO_BASE_URL=/audio

# Configuración de analytics (opcional)
NEXT_PUBLIC_ANALYTICS_ID=tu_analytics_id_aqui
NEXT_PUBLIC_GEMINI_API_KEY=

# Postgres (Supabase → Project Settings → Database) — Speaking Lab persistence + CMS
# Use pooler URL for serverless: port 6543 + ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# OpenAI (optional — mock STT/LLM when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# Resend — notificaciones (tickets de soporte, invitaciones, etc.)
# Con onboarding@resend.dev solo llegan correos a la cuenta de Resend.
# Para draloenglish@gmail.com: verifica dralo.es en https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=soporte@dralo.es
SUPPORT_TICKET_TO_EMAIL=draloenglish@gmail.com
RESEND_DEV_FALLBACK_TO=carlos.garcia.cano87@gmail.com






















