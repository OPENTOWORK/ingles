  for all to authenticated
  using (exists (select 1 from public.intentos_training it where it.id = respuestas_training.intento_id and it.user_id = auth.uid()))
  with check (exists (select 1 from public.intentos_training it where it.id = respuestas_training.intento_id and it.user_id = auth.uid()));

-- === 8) RPC (funciones para el frontend) ====================

-- leer un ejercicio completo en JSON (ejercicio + preguntas + opciones + medios)
drop function if exists public.get_ejercicio_completo(uuid);
create or replace function public.get_ejercicio_completo(p_ejercicio_id uuid)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare out_json jsonb;
begin
  with
  ex as (select * from public.ejercicios where id = p_ejercicio_id),
  qs as (
    select pe."order" as q_order, vp.id as qv_id, vp.stem, vp.question_type
    from public.preguntas_ejercicio pe
    join public.versiones_preguntas vp on vp.id = pe.question_version_id
    where pe.exercise_id = p_ejercicio_id
    order by pe."order"
  ),
  opts as (
    select o.question_version_id qv_id,
           jsonb_agg(jsonb_build_object('id',o.id,'body',o.body,'is_correct',o.is_correct,'order',o."order")
           order by o."order") as opciones
    from public.opciones o join qs on qs.qv_id=o.question_version_id
    group by o.question_version_id
  ),
  meds as (
    select pm.question_version_id qv_id,
           jsonb_agg(jsonb_build_object('media_id',m.id,'type',m.media_type,'path',m.storage_path,'role',pm.role,'order',pm."order")
           order by pm."order") as medios
    from public.preguntas_media pm
    join public.media m on m.id=pm.media_id
    join qs on qs.qv_id=pm.question_version_id
    group by pm.question_version_id
  ),
  qpack as (
    select q_order,
           jsonb_build_object('pregunta_version_id',qs.qv_id,'stem',qs.stem,'type',qs.question_type,
                              'opciones',coalesce(opts.opciones,'[]'::jsonb),
                              'medios',coalesce(meds.medios,'[]'::jsonb)) as qjson
    from qs left join opts on opts.qv_id=qs.qv_id
            left join meds on meds.qv_id=qs.qv_id
    order by q_order
  )
  select jsonb_build_object(
    'ejercicio', jsonb_build_object('id',ex.id,'title',ex.title,'description',ex.description,'skill',ex.skill,'level_ref',ex.level_ref,'time_cap_seconds',ex.time_cap_seconds),
    'preguntas', coalesce((select jsonb_agg(qjson order by q_order) from qpack), '[]'::jsonb)
  )
  into out_json
  from ex;
  return out_json;
end; $$;

-- empezar intento (devuelve id)
drop function if exists public.start_training_intent(uuid);
create or replace function public.start_training_intent(p_ejercicio_id uuid)
returns uuid
language sql
security definer
set search_path = public
as $$
  insert into public.intentos_training(user_id, ejercicio_id)
  values (auth.uid(), p_ejercicio_id)
  returning id;
$$;

-- guardar respuesta (choice u abierta)
drop function if exists public.save_training_answer(uuid,uuid,uuid,text,int, jsonb);
create or replace function public.save_training_answer(
  p_intento_id uuid,
  p_pregunta_version_id uuid,
  p_opcion_id uuid default null,
  p_respuesta_texto text default null,
  p_tiempo_ms integer default null,
  p_raw jsonb default null
)
returns void
language sql
security definer
set search_path = public
as $$
  insert into public.respuestas_training(
    intento_id, pregunta_version_id, opcion_id, respuesta_texto, tiempo_ms, raw
  )
  values (p_intento_id, p_pregunta_version_id, p_opcion_id, p_respuesta_texto, p_tiempo_ms, p_raw)
  on conflict (intento_id, pregunta_version_id) do update
    set opcion_id = excluded.opcion_id,
        respuesta_texto = excluded.respuesta_texto,
        tiempo_ms = excluded.tiempo_ms,
        raw = excluded.raw,
        updated_at = now();
$$;

-- enviar intento (calcula puntos y cierra)
drop function if exists public.submit_training_intent(uuid);
create or replace function public.submit_training_intent(p_intento_id uuid)
returns numeric
language plpgsql
security definer
set search_path = public
as $$
declare total numeric;
begin
  select coalesce(sum(pe.points),0) into total
  from public.respuestas_training r
  join public.intentos_training it on it.id = r.intento_id
  join public.preguntas_ejercicio pe
       on pe.exercise_id = it.ejercicio_id
      and pe.question_version_id = r.pregunta_version_id
  where r.intento_id = p_intento_id
    and coalesce(r.correcta,false) = true;

  update public.intentos_training
    set estado = 'submitted', fin = now(), puntaje_total = total
  where id = p_intento_id;

  return total;
end;
$$;

-- === 9) SEMILLA (opcional) — crea un ejemplo mínimo =========
-- Esto mete 1 pregunta MCQ con 3 opciones y un ejercicio con esa pregunta.

with q as (
  insert into public.preguntas (skill, base_stem, created_by)
  values ('reading','Choose the correct option', null)
  returning id
),
vp as (
  insert into public.versiones_preguntas (question_id, version, stem, question_type, status)
  select id, 1, 'Choose the correct option', 'multiple_choice', 'published' from q
  returning id
),
ej as (
  insert into public.ejercicios (title, skill, level_ref, created_by)
  values ('Reading Part 1', 'reading', 'B1', null)
  returning id
),
op as (
  insert into public.opciones (question_version_id, body, is_correct, "order")
  select vp.id, v.body, v.is_correct, v.ord
  from vp
  join (values ('A',false,1),('B',true,2),('C',false,3)) as v(body,is_correct,ord) on true
  returning 1
)
