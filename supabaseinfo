-- auto-evaluación si marcó opción
create or replace function public._eval_respuesta_training()
returns trigger
language plpgsql
as $$
begin
  if new.opcion_id is not null then
    select o.is_correct into new.correcta from public.opciones o where o.id = new.opcion_id;
  end if;
  return new;
end;
$$;

drop trigger if exists tg_eval_respuesta_training_ins on public.respuestas_training;
create trigger tg_eval_respuesta_training_ins
before insert or update on public.respuestas_training
for each row execute function public._eval_respuesta_training();

-- RLS: solo el dueño ve/escribe sus intentos y respuestas
alter table public.intentos_training  enable row level security;
alter table public.respuestas_training enable row level security;

create policy if not exists "it_read_own" on public.intentos_training
  for select to authenticated using (user_id = auth.uid());
create policy if not exists "it_write_own" on public.intentos_training
